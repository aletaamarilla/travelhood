# Sanity CMS (público - necesario para build)
SANITY_PROJECT_ID=
SANITY_DATASET=production
SANITY_API_VERSION=2026-03-16

# Sanity Token (solo para scripts CLI - NUNCA en frontend)
# SANITY_TOKEN=

# Google Tag Manager (público - se inyecta en el HTML)
PUBLIC_GTM_ID=

# Fase 1: activa SOLO el envelope nuevo y su page_view, tras verificar GTM.
# No controla la carga compartida de GTM ni las etiquetas Meta existentes.
PUBLIC_GTM_PHASE1_READY=false
# ID del flujo oficial, igual al destino GTM; opt-out anterior al contenedor.
# Si falta, el bootstrap conserva el opt-out del ID oficial G-XQMPJG8B08.
PUBLIC_GA_ID=
# production solo para el dominio comercial; test en previews/staging.
PUBLIC_ANALYTICS_ENV=test

# TikTok Pixel: ID conservado, carga suspendida hasta revisar CSP y privacidad.
# Véase docs/analytics/phase-1.md. Esta variable por sí sola NO carga el píxel.
PUBLIC_TIKTOK_PIXEL_ID=D9CFSPBC77UBS5FSE3HG

# URL pública del sitio (necesaria antes de conectar a Sanity)
PUBLIC_SITE_URL=https://travelhood.es

# Sanity Studio App ID (deployment)
SANITY_STUDIO_APP_ID=
