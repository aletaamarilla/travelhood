---
import { getCollaboratorsPage } from "@/lib/data-provider";

const content = await getCollaboratorsPage();
---
{content.collaborators.length > 0 && (
  <section aria-labelledby="home-collaborators-title" class="bg-teal-deep/5 py-12 sm:py-14">
    <div class="mx-auto max-w-7xl px-4 sm:px-6">
      <div class="grid gap-8 lg:grid-cols-[0.8fr_1.2fr] lg:items-center lg:gap-12">
        <div>
          <h2 id="home-collaborators-title" class="font-serif text-2xl font-bold tracking-tight text-foreground sm:text-3xl">{content.homeTitle}</h2>
          <p class="mt-3 max-w-md text-base leading-relaxed text-muted-foreground">{content.homeIntro}</p>
          <a href="/colaboradores/" data-collaborator="all" data-collaborator-source="home" data-collaborator-kind="discovery" class="mt-4 inline-flex min-h-11 items-center gap-2 rounded-lg font-bold text-teal-deep underline decoration-teal-deep/30 underline-offset-4 hover:decoration-teal-deep focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-teal-deep">
            Conocer a nuestros colaboradores <span aria-hidden="true">→</span>
          </a>
        </div>
        <ul class="grid gap-4 sm:grid-cols-2">
          {content.collaborators.map((partner) => (
            <li>
              <a href={"/colaboradores/#" + partner.slug} data-collaborator={partner.slug} data-collaborator-source="home" data-collaborator-kind="discovery" class="group flex h-full flex-col rounded-2xl border border-border/60 bg-card p-5 transition-colors hover:border-teal-deep/40 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-teal-deep">
                <div class="flex items-center justify-between gap-4">
                  {partner.logoUrl && <img
                    src={partner.logoUrl}
                    alt=""
                    width={partner.slug === "nomadcamper" ? 48 : 109}
                    height={partner.slug === "nomadcamper" ? 48 : 60}
                    loading="lazy"
                    decoding="async"
                    class:list={["shrink-0", partner.slug === "nomadcamper" ? "h-12 w-12 rounded-full object-cover" : "h-12 w-22 object-contain object-left"]}
                  />}
                  <span aria-hidden="true" class="ml-auto text-xl text-muted-foreground transition-transform group-hover:translate-x-1">→</span>
                </div>
                <h3 class="mt-3 font-serif text-lg font-bold text-foreground">{partner.name}</h3>
                <p class="mt-1 text-base leading-relaxed text-muted-foreground">{partner.summary}</p>
                {partner.benefit?.trim() && <p class="mt-3 text-sm font-bold text-teal-deep">{partner.benefit}</p>}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>
)}
